{
  "name": "close-claw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny Discord app that runs Claude CLI.",
  "packageManager": "pnpm@11.5.2",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "pnpm typecheck && biome check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.173",
    "@anthropic-ai/sdk": "^0.104.1",
    "consola": "^3.4.2",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
